# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 腾讯云 API 配置
# 获取地址: https://console.cloud.tencent.com/cam/capi
# 用于 DNSPod DNS 验证（必需）
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key

# 腾讯云地域（可选）
# 默认: ap-guangzhou
# TENCENT_REGION=ap-guangzhou

# ACME 账户邮箱（推荐）
# 用于接收 Let's Encrypt 证书过期提醒
ACME_ACCOUNT_EMAIL=your-email@example.com

# ACME 工作目录（可选）
# 本地测试时可以设置为 ./certs，证书将保存在项目目录下
# 云函数环境默认使用 /tmp/acme
# ACME_HOME_DIR=./certs

# ACME DNS 传播等待时间（可选）
# DNS TXT 记录添加后等待传播的时间（秒），默认 60
# ACME_DNS_PROPAGATION=60

# 证书过期提醒阈值（可选）
# 距离过期多少天时标记为即将过期，默认 30 天
# CERT_EXPIRY_WARNING_DAYS=30

# ACME 环境（可选）
# true 使用 Let's Encrypt 测试环境（无限制，证书不被信任）
# false 使用 Let's Encrypt 生产环境（有频率限制，证书被信任）
# 默认: false
ACME_STAGING=true

# 通知配置（可选）
# NOTIFY_ENABLED=true 启用通知
# NOTIFY_WEBHOOK 通知 Webhook URL
NOTIFY_ENABLED=false
# NOTIFY_WEBHOOK=https://your-webhook-url
